<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet manbalari (Wash naqshi).

  `Agentics.Platform.*` paketlari `agentics-platform` repo'sidan keladi:
  yonma-yon turgan repo'ning `dotnet pack` chiqishi (`../agentics-platform/artifacts/nuget`).
  Papka bo'sh bo'lsa restore XATO beradi; oldin o'sha repoda `dotnet pack -c Release`.

  ⚠️ Docker image va CI bu yo'lni ko'rmaydi — uch mahsulot uchun UMUMIY qarz
  (GitHub Packages, PLATFORMA-TZ §7·F5, HOLAT §4 #14). Docker build kontekstiga
  artefaktlar `build-context platform=../agentics-platform/artifacts` bayrog'i bilan beriladi
  (XML izohida ikki chiziqcha taqiqlangan — bayroq nomi shuning uchun prefikssiz).

  `packageSourceMapping` ATAYLAB: `Agentics.Platform.*` FAQAT o'z manbasidan olinadi.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="agentics-platform-local" value="../agentics-platform/artifacts/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="agentics-platform-local">
      <package pattern="Agentics.Platform.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
