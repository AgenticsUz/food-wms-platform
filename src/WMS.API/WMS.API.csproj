<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Host: ikki yuza (`/api` — wms-web, `/admin/v1` — Console), JIT, middleware zanjiri,
       controller'lar, health. `dotnet WMS.API.dll migrate` — migratsiya rejimi (alohida image yo'q). -->
  <PropertyGroup>
    <UserSecretsId>agentics-wms-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WMS.Infrastructure/WMS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platforma paketlari (PLATFORMA-TZ §5.2): JWT sxemalari, JIT, forwarded headers. -->
    <PackageReference Include="Agentics.Platform.Web" />
    <PackageReference Include="Agentics.Platform.Infrastructure" />

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

</Project>
