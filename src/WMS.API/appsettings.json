{
  "ConnectionStrings": {
    "wms": "",
    "wms_migrator": ""
  },
  "Auth": {
    "Issuer": "",
    "MetadataAddress": "",
    "Audiences": {
      "Wms": "wms-api",
      "Admin": "wms-admin-api"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "Migrations": {
    "Mode": "auto"
  },
  "Subscription": {
    "TrialDays": 14,
    "GraceDays": 3,
    "PaidGraceDays": 3,
    "StateCacheSeconds": 60,
    "WarnBeforeDays": 7,
    "LimitWarnPercent": 80
  },
  "Telegram": {
    "BotToken": "",
    "PollingIntervalSeconds": 2,
    "LongPollTimeoutSeconds": 30,
    "LinkTokenMinutes": 10,
    "OutboxBatchSize": 50,
    "OutboxRetentionDays": 14,
    "DefaultLanguage": "uz",
    "WebUrl": "",
    "OpsChatId": null,
    "DigestHour": 8,
    "QuietFromHour": 22,
    "QuietToHour": 7
  },
  "Ai": {
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "RouterModel": "",
    "Effort": "low",
    "MaxOutputTokens": 2048,
    "TimeoutSeconds": 60,
    "DailyUsdCap": 10,
    "HistoryRetentionDays": 90,
    "Pricing": {
      "claude-sonnet-5": {
        "InputPerMillion": 2.0,
        "OutputPerMillion": 10.0,
        "CacheWritePerMillion": 2.5,
        "CacheReadPerMillion": 0.2
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
