{
  "ConnectionStrings": {
    "wms": "",
    "wms_migrator": ""
  },
  "Auth": {
    "Issuer": "",
    "MetadataAddress": "",
    "Audiences": {
      "Wms": "wms-api",
      "Admin": "wms-admin-api"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "Migrations": {
    "Mode": "auto"
  },
  "Subscription": {
    "TrialDays": 14,
    "GraceDays": 3,
    "PaidGraceDays": 3,
    "StateCacheSeconds": 60,
    "WarnBeforeDays": 7,
    "LimitWarnPercent": 80
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
