# =============================================================================
#  AGENTICS WMS — docker/.env NAMUNASI
#  Nusxa: cp docker/.env.example docker/.env
#  docker/.env gitignore'da. Prod'da bu qiymatlar MAJBURIY almashtiriladi
#  (pastdagi «FAQAT PROD» bo'limi va har qatordagi izoh).
# =============================================================================

# --- Postgres (konteyner ichida 5432, hostda 5434 — D16; 5432 lokal PG, 5433 Wash) ---
POSTGRES_DB=agentics_wms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Dev_Postgres_2026!
POSTGRES_PORT=5434

# --- Ilova rollari (docker/postgres/init/01-roles-schemas.sql shu bilan yaratadi) ---
# ⚠️ `Dev_AppMigrator_2026!` WmsDbContextFactory (design-time, `dotnet ef`) sukuti
# bilan BIR XIL — dev'da o'zgartirilsa `dotnet ef` ham shu parolni olishi kerak.
# Prod: har biri 32+ tasodifiy belgi (openssl rand -base64 32), parol menejerida.
APP_USER_PASSWORD=Dev_AppUser_2026!
APP_MIGRATOR_PASSWORD=Dev_AppMigrator_2026!

# --- Servis portlari (host) ---
# Prod'da faqat WEB_PORT (127.0.0.1 ga) ochiladi; API_PORT va POSTGRES_PORT dev uchun.
API_PORT=5511
WEB_PORT=5510

# --- Identity (id.agentics.uz; dev'da platforma stack'i, http://localhost:5245) ---
# Brauzer ochadigan manzil — token `iss` bilan AYNAN bir xil bo'lishi shart.
# Prod: https://id.agentics.uz
PUBLIC_IDENTITY_URL=http://localhost:5245
# CORS ro'yxati uchun ilovaning o'z origini. Prod: https://wms.agentics.uz
PUBLIC_WEB_URL=http://localhost:5510

# JWT tekshiruvi uchun OIDC metadata — SERVERDAN ochiladigan manzil (bo'sh —
# PUBLIC_IDENTITY_URL ishlatiladi). PUBLIC_IDENTITY_URL brauzer uchun, bu esa
# wms-api uchun: ular boshqa bo'lishi mumkin (masalan ichki DNS nomi).
# Prod misol: https://id.agentics.uz/.well-known/openid-configuration
IDENTITY_METADATA_URL=

# --- Frontend runtime konfiguratsiyasi (docker/web-config/entrypoint.sh o'qiydi) ---
# PUBLIC_API_URL compose'da `/api` bo'lib qotirilgan: SPA API bilan bir originda
# (konteyner nginx'i proksilaydi), shuning uchun CORS qatnashmaydi.
DEFAULT_LOCALE=uz-Latn
IDLE_TIMEOUT_MINUTES=30

# --- Obuna siyosati (bo'sh qoldirilsa — appsettings.json sukutlari bilan bir xil) ---
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_PAID_GRACE_DAYS=3
SUBSCRIPTION_STATE_CACHE_SECONDS=60
SUBSCRIPTION_WARN_BEFORE_DAYS=7
SUBSCRIPTION_LIMIT_WARN_PERCENT=80

# --- Telegram bot (TG8) ---
# @BotFather tokeni. Bo'sh — bot o'chiq (xato emas). Dev: o'z test botingiz
# (@AgenticsWmsDevBot), prod: @AgenticsWmsBot — bir token ikki joyda polling
# qilinsa Telegram 409 beradi. Bot username'i kerak emas: kod `getMe` dan oladi.
TELEGRAM_BOT_TOKEN=

# --- Image nomlari (CI to'ldiradi) ---
# Dev: lokal build nomi. Prod: ghcr.io/agenticsuz (KICHIK harf — Docker katta
# harfli repo nomini rad etadi, GitHub egasi esa `AgenticsUz`).
IMAGE_REGISTRY=agentics-wms
# Prod'da deploy.yml `.env.tag` bilan ustidan yozadi (sha yoki latest).
IMAGE_TAG=local
# Faqat dev compose o'qiydi; prod compose'da `Production` qotirilgan.
ASPNETCORE_ENVIRONMENT=Development

# Migrator buyrug'i (faqat dev compose): `migrate` yoki demo tenant bilan `seed demo`.
# Prod compose'da `migrate` qotirilgan — prod'da demo tenant yo'q.
MIGRATOR_COMMAND=migrate
